# ---------------------------------------------------------------------------
# Raw data must NEVER be committed.
# The dataset lives OUTSIDE this repo (../Dataset) by design, but these rules
# are kept as a second line of defence in case a file is ever copied inward.
# ---------------------------------------------------------------------------
Dataset/
*.csv
!docs/data/*.csv
flights.csv
airlines.csv
airports.csv

# Kaggle / cloud credentials
kaggle.json
*.pem
*.key
.env
.env.*
secrets.*

# Processed intermediates (regenerated by the notebooks)
data/processed/*
!data/processed/.gitkeep
*.parquet
*.feather
*.pkl
*.joblib

# Virtual environment
.venv/
venv/
env/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# Jupyter
*.nbconvert.ipynb

# OS / editor
Thumbs.db
desktop.ini
.DS_Store
.vscode/
.idea/

# Large regenerable prediction dumps
*.npz
